{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/staff",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "node_modules/pdfjs-dist/{legacy/build/*.mjs,standard_fonts/**}"
    }
  }
}
